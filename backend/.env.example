# Servidor HTTP de la API
HOST=127.0.0.1
PORT=4000

# Ruta alternativa de la base SQLite (por defecto backend/data/aerohealth.db)
# DB_PATH=./data/aerohealth.db

# Origen permitido para CORS. En desarrollo puede ser * o http://localhost:3000
CORS_ORIGIN=*

# Límite del cuerpo JSON en bytes (2 MB por defecto)
# BODY_LIMIT_BYTES=2097152

# Registra cada petición en consola (1 = activado)
# LOG_REQUESTS=1
